__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor settings
.vscode/
.idea/

# Not needed inside the runtime image
tests/
spike/
doc/
app.spec

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
